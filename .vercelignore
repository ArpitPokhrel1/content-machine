# Per-machine settings and secrets: never committed. Template: asset-generation/.env.example
.env
.env.*
!.env.example
*.pem
*service-account*.json
application_default_credentials.json

# Dependencies (npm run setup reinstalls them)
node_modules/

# Generated media and working output (GBs, lives only on the machine that made it)
Outputs/
asset-generation/output/
asset-generation/references/*
!asset-generation/references/.gitkeep
map-animation/output/
map-animation/data/cache/
map-animation/dist/

# Unrelated business documents
Other/

# Poster tool: the unused source PNGs are over GitHub's 100 MB limit; the app loads the .webp
campaign-poster-tool/public/assets/*.png

# Logs and local tool state
*.log
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Vercel: never upload studio-only folders
knowledge/
campaign-poster-tool/
site/bundle/
