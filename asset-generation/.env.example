# Content Machine — per-machine settings. Copy to asset-generation/.env (or run `npm run setup`, which
# writes it for you). This is the ONLY file that changes between laptops. Never commit asset-generation/.env.

# ---- Option A: Google Cloud / Vertex AI (what the studio uses) ---------------------------------
# Your Google Cloud project ID (Cloud Console → project picker → ID column).
GOOGLE_CLOUD_PROJECT=
# Region for Veo and image generation.
GOOGLE_CLOUD_LOCATION=us-central1
# Region for the prompt-drafting text model.
PROMPT_LOCATION=global
# Optional Cloud Storage bucket for Veo output (name only, no gs://). Leave empty to receive
# videos inline instead; then the gcloud CLI isn't needed for downloads.
VIDEO_OUTPUT_BUCKET=
# Optional: path to a service-account JSON key, instead of `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/content-machine-sa.json

# ---- Option B: Gemini API key (no Cloud project) ------------------------------------------------
# Leave GOOGLE_CLOUD_PROJECT empty to use this. Get a key at https://aistudio.google.com/apikey
# Gemini-API model names differ: e.g. VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_API_KEY=

# ---- Models ------------------------------------------------------------------------------------
PROMPT_MODEL=gemini-3.1-flash-lite
VIDEO_MODEL=veo-3.1-fast-generate-001
IMAGE_MODEL=gemini-2.5-flash-image
# 1080p is honoured on 16:9 only; other aspect ratios are capped at 720p.
VIDEO_RESOLUTION=1080p

# ---- Parallelism -------------------------------------------------------------------------------
# Veo clips generated at the same time after approval.
VIDEO_CONCURRENCY=3
# Regions to spread image generation across. Each region has its own per-minute quota, so three
# regions ≈ three times the image throughput. Empty = GOOGLE_CLOUD_LOCATION only.
# IMAGE_LOCATIONS=us-central1,us-east4,europe-west4

# ---- Local server ------------------------------------------------------------------------------
PORT=4317
