{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarjun-content",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/install.ps1", "/install.sh"]
  },
  "ai": { "binding": "AI" },
  "routes": [
    { "pattern": "tarjun.com/*", "zone_name": "tarjun.com" },
    { "pattern": "www.tarjun.com/*", "zone_name": "tarjun.com" },
    { "pattern": "content.tarjun.com/*", "zone_name": "tarjun.com" }
  ],
  "rules": [
    { "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }
  ]
}
