{
  "name": "content-machine-site",
  "private": true,
  "type": "module",
  "description": "content.tarjun.com: setup page, installers and the install download for Content Machine.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "build:cloudflare": "node cloudflare/build.mjs",
    "dev:cloudflare": "wrangler dev --local --config cloudflare/wrangler.jsonc",
    "deploy:cloudflare": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "new-code": "node scripts/new-access-code.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "wrangler": "^4.167.0"
  }
}
